{
  "$schema": "https://raw.githubusercontent.com/nicegui/mirrors/tauri/tauri-v2/crates/tauri-cli/schema.json",
  "productName": "Mypets",
  "version": "0.1.0",
  "identifier": "com.mypets.desktop-pet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mypets",
        "transparent": true,
        "dragDropEnabled": false,
        "decorations": true,
        "shadow": true,
        "resizable": false,
        "center": true,
        "width": 1180,
        "height": 760
      }
    ],
    "security": {}
  }
}
